# Localhost smoketest env for the prod (nginx + bundled-asset) stack.
#
# Committed on purpose: every value here is a non-secret localhost dummy, so the
# prod-bundle smoketest is turnkey and reproducible (fresh clone, CI, cloud
# runner) with a single command and NO inline vars:
#
#   docker compose -f docker-compose.prod.yml --env-file .env.test up -d --build
#
# Pass `--env-file .env.test` to every prod compose subcommand (up/ps/logs/down)
# so interpolation of the `${VAR:?}` required vars always succeeds.
#
# POSTGRES_PASSWORD matches the dev default (docker-compose.yml) on purpose: the
# smoketest reuses the dev-initialised `pg_data` volume, so switching dev<->this
# stack never needs `docker compose down -v`. For a real deploy use
# .env.prod.example, not this file.
REDIS_PASSWORD=localtest
POSTGRES_PASSWORD=tensies
GRAFANA_ADMIN_PASSWORD=localtest
METRICS_TOKEN=localtest
STATS_TOKEN=localtest
ALLOWED_ORIGINS=http://localhost:8888
GRAFANA_ROOT_URL=http://localhost:8889
GRAFANA_PUBLISH=127.0.0.1:8889
WEB_PUBLISH=0.0.0.0:8888
TRUSTED_PROXY_HOPS=1
CSP_EXTRA_SCRIPT_SRC=
CSP_EXTRA_CONNECT_SRC=
JWT_SECRET=test-secret-localhost
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8888
